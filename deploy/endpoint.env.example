# Copy to /etc/endpoint/endpoint.env on the server (owner root:endpoint, chmod 640).
# Never commit the real file.
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Bangkok

DB_HOST=localhost
DB_PORT=5432
DB_NAME=endpoint_db
DB_USERNAME=endpoint_app
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# JWT_EXPIRATION=3600000

# Google Cloud key with Routes API enabled (restrict it to the VPS IP).
GOOGLE_MAPS_API_KEY=

# SERVER_PORT=8080
